{
  "name": "The Chocolate Story Admin",
  "short_name": "TCS Admin",
  "description": "Owner admin panel for The Chocolate Story.",
  "id": "./index.html",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#FBF7F1",
